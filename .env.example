# Local development placeholders only
APP_NAME=Netsol API
APP_VERSION=0.5.0

GEMINI_API_KEY=replace-with-your-local-gemini-key
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_INPUT_CHARS=4000
LLM_MAX_OUTPUT_TOKENS=300

POSTGRES_DB=chatbot
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=change-me-for-local-development

DATABASE_URL=postgresql+asyncpg://chatbot_user:change-me-for-local-development@db:5432/chatbot